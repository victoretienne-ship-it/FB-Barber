# Fichiers internes : jamais servis au navigateur (rappels.php est lancé par la tâche planifiée).
<FilesMatch "^(lib|config|config\.example|rappels)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
